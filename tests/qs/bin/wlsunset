#!/usr/bin/env bash
# A stand-in for wlsunset in tests (tests/qs/tst_night_light.qml), so the real screen is never tinted. Each start
# appends its arguments to $FAKE_WLSUNSET_LOG; it then runs until stopped, or, while the file
# $FAKE_WLSUNSET_LOG.fail exists, fails at once like wlsunset when another program holds the screen's gamma.
echo "$*" >> "$FAKE_WLSUNSET_LOG"
if [ -e "$FAKE_WLSUNSET_LOG.fail" ]; then
    echo "failed to create gamma control: in use by another client" >&2
    exit 1
fi
# it takes a moment to stop, as a real one fading the gamma back, so a second change can come while it does
trap 'sleep 0.3; exit 0' TERM INT
while :; do sleep 0.1; done
