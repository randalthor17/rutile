#!/usr/bin/env python3
"""A stand-in for matugen in tests: logs its arguments to $FAKE_MATUGEN_LOG and writes $FAKE_MATUGEN_FIXTURE to
every output_path of the config it is given (-c), as matugen would write the rendered templates."""
import os, re, sys
args = sys.argv[1:]
with open(os.environ["FAKE_MATUGEN_LOG"], "a") as f:
    f.write(" ".join(args) + "\n")
config = open(args[args.index("-c") + 1]).read()
text = open(os.environ["FAKE_MATUGEN_FIXTURE"]).read()
if os.path.exists(os.environ.get("FAKE_MATUGEN_BROKEN", "/nonexistent")):
    text = '{"format": 1, "mode": "dark", "source_color": "#123456", "colors": {}}'      # not a valid palette
for out in re.findall(r'^output_path = "(.*)"$', config, flags=re.M):
    os.makedirs(os.path.dirname(out), exist_ok=True)
    open(out, "w").write(text)
