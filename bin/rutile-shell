#!/bin/sh
# rutile-shell: run Rutile Shell under Quickshell, or talk to the running one (plan 6.1). The package wraps this with
# RUTILE_SHELL_QML set and everything the shell calls on PATH; from a checkout it finds ../shell/shell.qml.
# The IPC reference in usage() must match the IpcHandlers in shell/shell.qml (tests/test_cli.py checks).
set -eu

here=$(dirname -- "$(readlink -f -- "$0")")
qml=${RUTILE_SHELL_QML:-$here/../shell/shell.qml}
qs=${RUTILE_QUICKSHELL:-quickshell}

TARGETS="wallpaper motion power settings appcolors polkit lock launcher notifications calendar osd media input clipboard capture toast quicksettings tray shelf widgets"

usage() {
    cat <<'EOF'
Usage:
  rutile-shell [run] [QUICKSHELL OPTIONS]   start the shell (one per session; it is a user service with the
                                            home-manager module: systemctl --user restart rutile-shell)
  rutile-shell TARGET FUNCTION [ARGS...]    call the running shell, e.g. rutile-shell power toggle
  rutile-shell ipc                          list what the running shell answers, with argument types
  rutile-shell ipc call|show|... [...]      Quickshell's own ipc command, for this shell
  rutile-shell log [OPTIONS]                the running shell's log (quickshell log)
  rutile-shell kill                         stop the running shell
  rutile-shell -h | --help | help           this help
  rutile-shell quickshell-help              Quickshell's own options (for run)
  rutile-shell greeter [QUICKSHELL OPTIONS] the sign-in screen, as greetd runs it (nixosModules.greeter, D97)
  rutile-shell flatpak-theming [-y]         let Flatpak apps wear the shell's look: install adw-gtk3 and Kvantum
                                            from Flathub (for this user) and give apps your GTK, Kvantum and KDE
                                            settings, read-only; -y: no questions (Settings, Wallpaper & style)
  rutile-shell flatpak-theming --terminal   the same in a new terminal window
  rutile-shell widgets check FILE [--json]  check a widget file against the spec (the running shell checks it):
                                            "FILE: $.where: what" lines, or JSON {"ok", "problems"}; exit 1 if wrong
  rutile-shell widgets install FILE [--place] [--json]
                                            check it, then copy it to ~/.config/rutile/widgets (a free name);
                                            --place also puts it on the desktop; prints the new path (or JSON)

IPC (TARGET FUNCTION ARGS: what it does; "state" gives JSON for scripts and diagnostics):
  wallpaper      set PATH          set the wallpaper (absolute path; "" removes it); false if set in Nix
                 get               the wallpaper's path
                 state
  motion         setSpeed N        animation speed, 0 (off) to 4, saved; false if out of range or set in Nix
                 speed             the current speed
  power          toggle | open | close
                 isOpen
                 choose ID         lock, suspend, logout, reboot or poweroff, as a click in the open menu
                 state
  settings       open PAGE         open the Settings app on a page ("" keeps the current one): wallpaper,
                                   connections (network and bluetooth open it too), display, sound, power,
                                   input, windows, apps,
                                   notifications, calendar, security, shelf, widgets, accessibility, about; open already, it is focused.
                                   "rutile-shell settings" alone opens it as it was (its desktop file)
                 openSetting PAGE KEY   the same, with one setting ringed (e.g. security lock.idleMinutes)
                 close | toggle
                 isOpen
                 search TEXT       type into the open Settings app's search
                 state
  widgets        preview PATH      show a widget file in a window with its live data; saving the file shows it
                                   again (the package's examples: share/rutile/widgets/examples)
                 close
                 state             the preview's
                 edit | done       move, resize, add and remove the desktop's widgets (or right-click the desktop)
                 add PATH          put a widget file on the focused screen's desktop
                 remove ID         take one off
                 move ID SCREEN    move one to another screen (an output name, as in layout), while editing
                 layout            what each screen has, with the ids
                 gallery [CATEGORY]  the Widgets app: templates (weather, daily-update, world-clock, finance,
                                   countdown, sports) and your widgets (yours)
                 use TEMPLATE      use a template from the open app, e.g. weather-1
                 check PATH        a widget file's problems, one per line (rutile-shell widgets check FILE)
                 checkJson PATH    the same as JSON
                 galleryClose | galleryState
  appcolors      state             colors for other apps (Settings, Wallpaper: off unless switched on)
  polkit         cancel            cancel the open password dialog
                 state
  lock           lock              lock the screen
                 isLocked
                 state
  launcher       toggle | open | close
                 isOpen
                 search QUERY      type into the open launcher; the first results' ids
                 category ID       choose a category ("" is All); the first results' ids
                 launch ID         open an app, a setting such as qs:dark, or a result shown (settings:security)
                 actions APP       an app's desktop actions
                 chooseAction APP ACTION
                 togglePin APP     pin or unpin an app; false if the pins are set in Nix
                 setListView BOOL  apps as a list (true) or a grid
                 state
  notifications  toggle            the notification list
                 isOpen
                 dnd               whether Do not disturb is on
                 setDnd BOOL
                 dismiss ID | dismissAll
                 invoke ID ACTION  as a click on a notification's action
                 reply ID TEXT
                 state
  calendar       toggle | open | close   the calendar under the clock
                 isOpen
                 select DAY        open it on a day, as YYYY-MM-DD
                 state
  osd            volumeUp | volumeDown | toggleMute
                 brightnessUp | brightnessDown    false without a backlight
                 display KIND      show the volume or brightness OSD
                 state
  media          playPause | next | previous   the player playing (else the first); false without one
                 state             the players, and what the current one plays
  input          next              the next input method of fcitx5's group (bind it to a key)
                 set NAME          an input method by fcitx5's name: keyboard-us, m17n_bn_itrans...
                 configure         fcitx5's settings
                 state
  clipboard      toggle | open | close   the clipboard history (bind it to Mod+V)
                 isOpen
                 choose INDEX      copy back the open picker's entry INDEX, as a click
                 state
  capture        open | close | toggle   the capture bar: screenshot or record a region, window or screen
                 screenshot TARGET   at once: region, window (niri only) or screen
                 record TARGET AUDIO   region or screen until stop; AUDIO true adds the microphone
                 stop
                 choose TARGET     as a click on the open bar's region, window or screen
                 setRecord BOOL    the open bar's mode: record or screenshot
                 state
  toast          send TEXT ICON    a short message (ICON: a Material Symbols name, or ""); its id
                 state
  quicksettings  toggle | open | close
                 details PAGE      open at a tile's page: wifi, bluetooth, nightLight, powerSaver, mic ("" for the tiles)
                 isOpen
                 keepAwake true|false  no lock, screen blanking or sleep on idle, for this session
                 state
  tray           activate ID       as a click on an app indicator (state lists their ids)
                 openMenu ID      its menu, under its icon
                 closeMenu
                 choose TEXT      the open menu's entry with that text (a submenu opens in place)
                 back             out of a submenu
                 iconPath NAME    where the shell finds that icon ("": not found)
                 state
  shelf          openMenu TARGET   a pin's (its app id) or a window's (window:ID) right-click menu
                 choose TEXT       the open menu's entry with that text
                 closeMenu
                 tooltip TEXT      a tooltip mid-shelf, as over a button ("": hides it)
                 state

Examples:
  rutile-shell lock lock
  rutile-shell osd volumeUp
  rutile-shell wallpaper set ~/Pictures/wall.png
  rutile-shell toast send "Screenshot saved" photo_camera
EOF
}

# Flatpak apps see none of the host's themes and settings (D66). GTK 3 apps get adw-gtk3 as a Flathub extension,
# Qt apps the Kvantum style for each KDE runtime installed, and every app read-only access to gtk.css, the Kvantum
# theme and kdeglobals (the KDE runtime's platform theme reads colors, fonts, icons and the widget style there), and
# to /nix/store, where home-manager's links point. Java apps get niri's fix for blank windows (as on the host).
flatpak_theming() {
    if ! command -v flatpak >/dev/null 2>&1; then
        echo "rutile-shell: flatpak is not installed" >&2
        return 1
    fi
    yes=
    [ "${1-}" = "-y" ] && yes=-y
    flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || return 1
    refs="org.gtk.Gtk3theme.adw-gtk3 org.gtk.Gtk3theme.adw-gtk3-dark"
    kde=$(flatpak list --runtime --columns=application,branch | while read -r id branch; do
        [ "$id" = org.kde.Platform ] && echo "$branch"
    done | sort -u)
    for branch in $kde; do
        if flatpak remote-info --user flathub "org.kde.KStyle.Kvantum//$branch" >/dev/null 2>&1; then
            refs="$refs org.kde.KStyle.Kvantum//$branch"
        else
            echo "rutile-shell: Flathub has no Kvantum for KDE runtime $branch; its apps keep their style"
        fi
    done
    # shellcheck disable=SC2086
    flatpak install --user --or-update $yes flathub $refs || return 1
    set -- --filesystem=xdg-config/gtk-3.0:ro --filesystem=xdg-config/gtk-4.0:ro \
        --filesystem=xdg-config/Kvantum:ro --filesystem=xdg-config/kdeglobals:ro \
        --env=QT_QPA_PLATFORMTHEME=kde --env=_JAVA_AWT_WM_NONREPARENTING=1
    [ -d /nix/store ] && set -- "$@" --filesystem=/nix/store:ro
    flatpak override --user "$@" || return 1
    echo "Done. Flatpak apps wear the shell's look from their next start."
}

# Runs flatpak-theming in a new terminal window, so its downloads and questions show (Settings starts it this way).
in_terminal() {
    self=$RUTILE_CLI
    for t in ${TERMINAL:-} xdg-terminal-exec kitty ghostty foot alacritty wezterm konsole gnome-terminal xterm; do
        command -v "$t" >/dev/null 2>&1 || continue
        case "$t" in
            xdg-terminal-exec|kitty|foot) exec "$t" "$self" flatpak-theming --pause ;;
            wezterm) exec "$t" start -- "$self" flatpak-theming --pause ;;
            gnome-terminal) exec "$t" -- "$self" flatpak-theming --pause ;;
            *) exec "$t" -e "$self" flatpak-theming --pause ;;
        esac
    done
    echo "rutile-shell: no terminal found (set TERMINAL)" >&2
    "$self" toast send "No terminal found to set up Flatpak apps (set TERMINAL)" "error" >/dev/null 2>&1 || true
    return 1
}

# `widgets check` and `widgets install` (plan 4.6, D85): the running shell checks the file (the package has no
# Python); installing is a copy into the user's widget folder under a name not taken yet.
absolute() {
    case "$1" in
        /*) printf '%s\n' "$1" ;;
        *) printf '%s\n' "$PWD/$1" ;;
    esac
}
widgets_check() {
    file= json=0
    for a do
        case "$a" in
            --json) json=1 ;;
            -*) echo "rutile-shell: widgets check: unknown option $a" >&2; exit 2 ;;
            *) file=$(absolute "$a") ;;
        esac
    done
    [ -n "$file" ] || { echo "rutile-shell: widgets check needs a FILE" >&2; exit 2; }
    if [ "$json" -eq 1 ]; then
        out=$("$qs" ipc -p "$qml" call widgets checkJson "$file")
        printf '%s\n' "$out"
        case "$out" in *'"ok":true'*) exit 0 ;; *) exit 1 ;; esac
    fi
    out=$("$qs" ipc -p "$qml" call widgets check "$file")
    printf '%s\n' "$out"
    case "$(printf '%s\n' "$out" | tail -n 1)" in ok:*) exit 0 ;; *) exit 1 ;; esac
}
widgets_install() {
    file= json=0 place=0
    for a do
        case "$a" in
            --json) json=1 ;;
            --place) place=1 ;;
            -*) echo "rutile-shell: widgets install: unknown option $a" >&2; exit 2 ;;
            *) file=$(absolute "$a") ;;
        esac
    done
    [ -n "$file" ] || { echo "rutile-shell: widgets install needs a FILE" >&2; exit 2; }
    result=$("$qs" ipc -p "$qml" call widgets checkJson "$file")
    case "$result" in
        *'"ok":true'*) ;;
        *)
            if [ "$json" -eq 1 ]; then printf '%s\n' "$result"; else "$qs" ipc -p "$qml" call widgets check "$file" >&2; fi
            exit 1
            ;;
    esac
    dir=${XDG_CONFIG_HOME:-$HOME/.config}/rutile/widgets
    stem=$(basename -- "$file" .json)
    target=$dir/$stem.json
    n=2
    while [ -e "$target" ]; do
        target=$dir/$stem-$n.json
        n=$((n + 1))
    done
    mkdir -p -- "$dir"
    cp -- "$file" "$target"
    placed=false
    if [ "$place" -eq 1 ]; then
        [ "$("$qs" ipc -p "$qml" call widgets add "$target")" = true ] && placed=true
    fi
    if [ "$json" -eq 1 ]; then
        printf '{"ok":true,"path":"%s","placed":%s}\n' "$target" "$placed"
    else
        printf '%s\n' "$target"
        [ "$place" -eq 0 ] || [ "$placed" = true ] || echo "rutile-shell: no room on the desktop for it" >&2
    fi
}

is_target() {
    for t in $TARGETS; do
        [ "$t" = "$1" ] && return 0
    done
    return 1
}

# this command, which the shell starts again for Settings' Flatpak button (the package sets its wrapper)
RUTILE_CLI=${RUTILE_CLI:-$(readlink -f -- "$0")}
export RUTILE_CLI

if [ $# -eq 0 ]; then
    exec "$qs" -p "$qml"
fi

case "$1" in
    -h|--help|help)
        usage
        ;;
    quickshell-help)
        exec "$qs" --help
        ;;
    greeter)
        shift
        exec "$qs" -p "$(dirname -- "$qml")/greeter.qml" "$@"
        ;;
    flatpak-theming)
        shift
        case "${1-}" in
            --terminal) in_terminal ;;
            --pause)
                status=0
                flatpak_theming || status=$?
                [ "$status" -eq 0 ] || echo "Not finished: see above."
                printf 'Press Enter to close. '
                read -r _ || true
                exit "$status"
                ;;
            *) flatpak_theming "$@" ;;
        esac
        ;;
    run)
        shift
        exec "$qs" -p "$qml" "$@"
        ;;
    -*)
        exec "$qs" -p "$qml" "$@"
        ;;
    ipc)
        shift
        if [ $# -eq 0 ]; then
            exec "$qs" ipc -p "$qml" show
        fi
        exec "$qs" ipc -p "$qml" "$@"
        ;;
    log)
        shift
        exec "$qs" log -p "$qml" "$@"
        ;;
    kill)
        exec "$qs" kill -p "$qml"
        ;;
    *)
        if is_target "$1"; then
            # the Settings app's desktop file: open it, on the page it shows (one window, focused if open)
            if [ "$1" = settings ] && [ $# -eq 1 ]; then
                exec "$qs" ipc -p "$qml" call settings open ""
            fi
            if [ "$1" = widgets ] && [ "${2-}" = check ]; then
                shift 2
                widgets_check "$@"
            fi
            if [ "$1" = widgets ] && [ "${2-}" = install ]; then
                shift 2
                widgets_install "$@"
                exit 0
            fi
            # the Widgets app from its desktop file: the category it shows
            if [ "$1" = widgets ] && [ "${2-}" = gallery ] && [ $# -eq 2 ]; then
                exec "$qs" ipc -p "$qml" call widgets gallery ""
            fi
            # a widget file to preview: the shell needs its full path
            if [ "$1" = widgets ] && { [ "${2-}" = preview ] || [ "${2-}" = add ]; } && [ $# -eq 3 ]; then
                case "$3" in
                    /*) ;;
                    *) set -- "$1" "$2" "$PWD/$3" ;;
                esac
            fi
            if [ $# -lt 2 ]; then
                echo "rutile-shell: $1 needs a function; see rutile-shell --help" >&2
                exit 2
            fi
            exec "$qs" ipc -p "$qml" call "$@"
        fi
        echo "rutile-shell: unknown command '$1'; see rutile-shell --help" >&2
        exit 2
        ;;
esac
