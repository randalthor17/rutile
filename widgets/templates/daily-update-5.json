{
  "version": 1,
  "name": "Agenda",
  "root": {
    "type": "card",
    "children": [
      {
        "type": "header",
        "title": "Agenda for {{clock.weekday}}",
        "icon": "event_note"
      },
      {
        "type": "listRow",
        "title": "{{calendar.events.title}}",
        "icon": "event",
        "subtitle": "{{calendar.events.when}}"
      },
      {
        "type": "progress",
        "value": "{{clock.dayProgress}}",
        "style": "wavy"
      }
    ]
  },
  "sources": {
    "calendar": {
      "path": "~/.calendars",
      "days": 7
    }
  }
}
