{
  "version": 1,
  "name": "Countdown Timer",
  "root": {
    "type": "column",
    "children": [
      {
        "type": "card",
        "tone": "primary_container",
        "children": [
          {
            "type": "header",
            "icon": "timer",
            "title": "Countdown"
          },
          {
            "type": "stat",
            "label": "Until Christmas",
            "value": "{{countdown.text}}"
          },
          {
            "type": "progress",
            "value": "{{countdown.remaining}}",
            "style": "wavy"
          }
        ]
      }
    ]
  },
  "sources": {
    "countdown": {
      "target": "2026-12-25",
      "from": "2026-12-01"
    }
  }
}
