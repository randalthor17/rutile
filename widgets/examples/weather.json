{
  "version": 1,
  "name": "Weather Dashboard",
  "root": {
    "type": "column",
    "children": [
      {
        "type": "card",
        "tone": "surface_container",
        "children": [
          {
            "type": "header",
            "icon": "weather_sunny",
            "title": "Current Weather"
          },
          {
            "type": "stat",
            "label": "Temperature",
            "value": "{{weather.temperature}}",
            "unit": "°C"
          },
          {
            "type": "heroImage",
            "source": "{{weather.icon}}",
            "aspect": "16:9"
          }
        ]
      }
    ]
  }
}