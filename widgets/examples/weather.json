{
  "version": 1,
  "name": "Weather Dashboard",
  "root": {
    "type": "column",
    "children": [
      {
        "type": "card",
        "tone": "surface_container",
        "children": [
          {
            "type": "header",
            "icon": "sunny",
            "title": "Current Weather"
          },
          {
            "type": "stat",
            "label": "High {{weather.high}}° · Low {{weather.low}}°",
            "value": "{{weather.temperature}}",
            "unit": "°"
          },
          {
            "type": "row",
            "spacing": "sm",
            "children": [
              {
                "type": "chip",
                "icon": "partly_cloudy_day",
                "label": "{{weather.condition}}"
              },
              {
                "type": "chip",
                "icon": "air",
                "label": "{{weather.wind}}"
              }
            ]
          }
        ]
      }
    ]
  }
}
