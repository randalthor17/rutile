{
  "version": 1,
  "name": "Event List",
  "root": {
    "type": "column",
    "children": [
      {
        "type": "card",
        "tone": "surface_container",
        "children": [
          {
            "type": "header",
            "icon": "event",
            "title": "Upcoming Events"
          },
          {
