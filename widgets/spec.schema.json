{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rutile widget spec v1",
  "description": "A widget: a versioned tree of nodes, and options for the data sources it binds. Checked by tools/widget_check.py.",
  "type": "object",
  "required": [
    "version",
    "name",
    "root"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "root": {
      "$ref": "#/$defs/node"
    },
    "sources": {
      "$ref": "#/$defs/sources"
    }
  },
  "$defs": {
    "node": {
      "description": "Any node; the `type` field selects which.",
      "oneOf": [
        {
          "$ref": "#/$defs/row"
        },
        {
          "$ref": "#/$defs/column"
        },
        {
          "$ref": "#/$defs/grid"
        },
        {
          "$ref": "#/$defs/card"
        },
        {
          "$ref": "#/$defs/header"
        },
        {
          "$ref": "#/$defs/tile"
        },
        {
          "$ref": "#/$defs/heroImage"
        },
        {
          "$ref": "#/$defs/stat"
        },
        {
          "$ref": "#/$defs/progress"
        },
        {
          "$ref": "#/$defs/listRow"
        },
        {
          "$ref": "#/$defs/chip"
        },
        {
          "$ref": "#/$defs/chart"
        }
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Plain text, optionally with bindings written {{source.field}}; never code."
    },
    "binding": {
      "type": "string",
      "pattern": "^\\{\\{\\s*[a-z]+(\\.[A-Za-z_][A-Za-z0-9_]*)+\\s*\\}\\}$",
      "description": "Exactly one binding, e.g. {{battery.level}}."
    },
    "icon": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "A Material Symbols ligature name, e.g. timer."
    },
    "tone": {
      "enum": [
        "background",
        "error_container",
        "inverse_surface",
        "primary",
        "primary_container",
        "secondary",
        "secondary_container",
        "surface",
        "surface_bright",
        "surface_container",
        "surface_container_high",
        "surface_container_highest",
        "surface_container_low",
        "surface_container_lowest",
        "surface_dim",
        "surface_variant",
        "tertiary",
        "tertiary_container"
      ],
      "description": "A Rutile surface color role (theme/roles.json), snake_case."
    },
    "spacing": {
      "enum": [
        "none",
        "xs",
        "sm",
        "md",
        "lg",
        "xl",
        "xxl",
        "xxxl"
      ],
      "description": "A Spacing token name (shell/common/Spacing.qml)."
    },
    "row": {
      "type": "object",
      "description": "Children side by side.",
      "required": [
        "type",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "row"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          },
          "description": "Child nodes, in order."
        },
        "spacing": {
          "$ref": "#/$defs/spacing"
        }
      }
    },
    "column": {
      "type": "object",
      "description": "Children stacked.",
      "required": [
        "type",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "column"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          },
          "description": "Child nodes, in order."
        },
        "spacing": {
          "$ref": "#/$defs/spacing"
        }
      }
    },
    "grid": {
      "type": "object",
      "description": "Children in a grid of `columns` columns.",
      "required": [
        "type",
        "children",
        "columns"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "grid"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          },
          "description": "Child nodes, in order."
        },
        "spacing": {
          "$ref": "#/$defs/spacing"
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      }
    },
    "card": {
      "type": "object",
      "description": "A surface holding other nodes.",
      "required": [
        "type",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "card"
        },
        "tone": {
          "$ref": "#/$defs/tone"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          },
          "description": "Child nodes, in order."
        }
      }
    },
    "header": {
      "type": "object",
      "description": "A title with an optional icon.",
      "required": [
        "type",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "header"
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "title": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "tile": {
      "type": "object",
      "description": "A tinted block.",
      "required": [
        "type",
        "tone",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "tile"
        },
        "tone": {
          "$ref": "#/$defs/tone"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          },
          "description": "Child nodes, in order."
        }
      }
    },
    "heroImage": {
      "type": "object",
      "description": "A large image from a path, URL or binding.",
      "required": [
        "type",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "heroImage"
        },
        "source": {
          "$ref": "#/$defs/text"
        },
        "aspect": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$",
          "description": "Width:height, e.g. 16:9."
        }
      }
    },
    "stat": {
      "type": "object",
      "description": "A big value with a label and unit.",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "stat"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "value": {
          "$ref": "#/$defs/text"
        },
        "unit": {
          "type": "string",
          "maxLength": 12
        }
      }
    },
    "progress": {
      "type": "object",
      "description": "A progress indicator.",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "progress"
        },
        "value": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "$ref": "#/$defs/binding"
            }
          ],
          "description": "0 to 1, or a binding that yields one."
        },
        "style": {
          "enum": [
            "linear",
            "wavy"
          ]
        }
      }
    },
    "listRow": {
      "type": "object",
      "description": "One row of a list.",
      "required": [
        "type",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "listRow"
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "subtitle": {
          "$ref": "#/$defs/text"
        },
        "trailingIcon": {
          "$ref": "#/$defs/icon"
        }
      }
    },
    "chip": {
      "type": "object",
      "description": "A small labelled chip.",
      "required": [
        "type",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "chip"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "icon": {
          "$ref": "#/$defs/icon"
        }
      }
    },
    "chart": {
      "type": "object",
      "description": "A chart (D87): a line or area chart of a list of numbers over time (one, or several as `series`), a bar chart of numbers or labelled values, a pie or donut of labelled values, or a gauge of one value.",
      "required": [
        "type",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "chart"
        },
        "kind": {
          "enum": [
            "line",
            "area",
            "bar",
            "pie",
            "donut",
            "gauge"
          ],
          "description": "line and area: `values`, or `series` of histories (several lines); bar: `values` or `series`; pie and donut: `series`; gauge: `value`."
        },
        "values": {
          "anyOf": [
            {
              "$ref": "#/$defs/binding"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 300,
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "$ref": "#/$defs/binding"
                  }
                ]
              }
            }
          ],
          "description": "Numbers, oldest first: a binding to a source's numbers (e.g. {{system.cpuHistory}}) or a list of numbers and bindings."
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "description": "Labelled values, one bar or slice each; for line and area, histories, one line each (e.g. download and upload).",
          "items": {
            "type": "object",
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "$ref": "#/$defs/text"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "$ref": "#/$defs/binding"
                  }
                ]
              },
              "tone": {
                "$ref": "#/$defs/tone"
              }
            }
          }
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/binding"
            }
          ],
          "description": "A gauge's value."
        },
        "min": {
          "type": "number",
          "description": "The bottom of the scale; 0 when missing."
        },
        "max": {
          "type": "number",
          "description": "The top of the scale; the largest value when missing (100 for a gauge)."
        },
        "points": {
          "type": "integer",
          "minimum": 2,
          "maximum": 300,
          "description": "How many samples a line or area chart's width spans, the newest at the right; 60 when missing (a minute of a source read every second)."
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "unit": {
          "type": "string",
          "maxLength": 12
        },
        "tone": {
          "$ref": "#/$defs/tone"
        },
        "size": {
          "enum": [
            "small",
            "medium",
            "large"
          ],
          "description": "How tall it is; medium when missing."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "line",
                  "area"
                ]
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "values"
                ]
              },
              {
                "required": [
                  "series"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "pie",
                  "donut"
                ]
              }
            }
          },
          "then": {
            "required": [
              "series"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "gauge"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "bar"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "values"
                ]
              },
              {
                "required": [
                  "series"
                ]
              }
            ]
          }
        }
      ]
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "description": "Options for the data sources the widget binds (widgets/sources.json). Sources without options need no entry.",
      "properties": {
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "utcOffset": {
              "type": "number",
              "minimum": -14,
              "maximum": 14,
              "description": "Hours from UTC for another place's time (a world clock); the local time when missing."
            }
          }
        },
        "system": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "history": {
              "type": "integer",
              "minimum": 2,
              "maximum": 300,
              "description": "How many samples a history keeps; 60 when missing."
            },
            "every": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 10,
              "description": "Seconds between readings; 1 when missing."
            }
          }
        },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "card": {
              "type": "string",
              "pattern": "^(card[0-9]+|nvidia[0-9]+)$",
              "description": "Which card: card1 (/sys/class/drm/card1) or nvidia0; the one with the most video memory when missing."
            },
            "history": {
              "type": "integer",
              "minimum": 2,
              "maximum": 300,
              "description": "How many samples a history keeps; 60 when missing."
            },
            "every": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 10,
              "description": "Seconds between readings; 1 when missing."
            }
          }
        },
        "sensors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "history": {
              "type": "integer",
              "minimum": 2,
              "maximum": 300,
              "description": "How many samples a history keeps; 60 when missing."
            },
            "every": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 10,
              "description": "Seconds between readings; 1 when missing."
            }
          }
        },
        "countdown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target"
          ],
          "properties": {
            "target": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2})?)?$",
              "description": "The moment counted down to: A local date, or date and time: 2026-12-25 or 2026-12-25T18:00."
            },
            "from": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2})?)?$",
              "description": "Where the count started, for remaining and progress: A local date, or date and time: 2026-12-25 or 2026-12-25T18:00."
            }
          }
        },
        "weather": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "units": {
              "enum": [
                "metric",
                "imperial"
              ]
            }
          },
          "description": "The place and units; Settings > Widgets gives them when missing."
        },
        "calendar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "^(/|~/)",
              "description": "An .ics file or a folder of them, absolute or from ~/. Missing: the user's own calendars, as the calendar under the clock shows them (Settings > Calendar and the accounts)."
            },
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "description": "How many days ahead; 7 when missing."
            }
          }
        },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https?://",
              "maxLength": 500,
              "description": "A JSON document; only URLs that Settings > Widgets allows are fetched."
            },
            "every": {
              "type": "integer",
              "minimum": 60,
              "maximum": 86400,
              "description": "Seconds between fetches; 900 when missing."
            }
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "^(/|~/)",
              "description": "A text file, absolute or from ~/."
            }
          }
        }
      }
    }
  }
}
