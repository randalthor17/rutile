{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rutile Widget Schema v1",
  "type": "object",
  "required": ["version", "name", "root"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "description": "Human-readable widget name"
    },
    "root": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["row", "column", "grid", "card", "header", "tile", "heroImage", "stat", "progress", "listRow", "chip"]
        }
      }
    }
  }
}